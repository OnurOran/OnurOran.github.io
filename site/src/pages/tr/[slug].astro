---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("tr");
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// the English twin, if this article has been translated
const twin = await getEntry("en", post.data.translationKey);

// language buttons follow the article, not the site root
const hrefs = {
  tr: `/tr/${post.id}/`,
  en: twin ? `/en/${twin.id}/` : "/en/",
};

const fmt = post.data.pubDate.toLocaleDateString("tr-TR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang="tr"
  hrefs={hrefs}
>
  <header class="masthead">
    <span class="stamp">{fmt}</span>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>
  </header>
  <article>
    <Content />
    {twin && (
      <p class="translated">
        Bu yazının İngilizcesi: <a href={`/en/${twin.id}/`}>{twin.data.title}</a>
      </p>
    )}
  </article>
</Base>
