---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("en");
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// the Turkish twin, if this article has been translated
const twin = await getEntry("tr", post.data.translationKey);

// language buttons follow the article, not the site root
const hrefs = {
  en: `/en/${post.id}/`,
  tr: twin ? `/tr/${twin.id}/` : "/tr/",
};

const fmt = post.data.pubDate.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  lang="en"
  hrefs={hrefs}
>
  <header class="masthead">
    <span class="stamp">{fmt}</span>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>
  </header>
  <article>
    <Content />
    {twin && (
      <p class="translated">
        Türkçesi: <a href={`/tr/${twin.id}/`}>{twin.data.title}</a>
      </p>
    )}
  </article>
</Base>
