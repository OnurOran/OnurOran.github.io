---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "tr" | "en";
  /** Where each language button should go. Defaults to the two index pages,
      so an article can hand over the URL of its own translation instead. */
  hrefs?: { tr: string; en: string };
}

const {
  title,
  description,
  lang = "tr",
  hrefs = { tr: "/tr/", en: "/en/" },
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="tr" href={new URL(hrefs.tr, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(hrefs.en, Astro.site)} />
  </head>
  <body>
    <div class="bar">
      <div class="bar-in">
        <a class="brand" href={`/${lang}/`}>Onur Oran</a>
        <nav class="langs">
          <a href={hrefs.tr} aria-current={lang === "tr" ? "true" : undefined}>TR</a>
          <a href={hrefs.en} aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </nav>
      </div>
    </div>
    <div class="wrap">
      <slot />
      <footer class="site">
        {lang === "tr"
          ? "Yazılım mühendisi, İstanbul. Denediğim şeyler hakkında yazıyorum."
          : "Software engineer, Istanbul. I write about things I have actually run."}
      </footer>
    </div>
  </body>
</html>
